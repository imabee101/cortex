[Unit]
Description=Cortex release runner (GitHub Actions, label cortex-prod)
After=network-online.target
Wants=network-online.target

[Service]
User=cortex-deploy
WorkingDirectory=/var/lib/cortex-deploy/runner
ExecStart=/var/lib/cortex-deploy/runner/run.sh
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=300
# sudo (two commands, see cortex-deploy.sudoers) needs setuid, so NoNewPrivileges stays off.
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
