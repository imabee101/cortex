[Unit]
Description=TLS edge for llm.imabee.com (Caddy to cortex-api)
After=network-online.target cortex-api.service
Wants=network-online.target

[Service]
User=imma
Environment=XDG_DATA_HOME=%S/cortex-edge XDG_CONFIG_HOME=%S/cortex-edge
StateDirectory=cortex-edge
RuntimeDirectory=cortex-edge
ExecStart=/usr/bin/caddy run --config /etc/cortex/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/cortex/Caddyfile --adapter caddyfile --address unix//run/cortex-edge/admin.sock --force
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65535
# Streams outlive a reload; a stop gives them a minute.
TimeoutStopSec=60
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
